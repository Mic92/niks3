      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "redirectTTL": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "maxNarSize": {
      "type": [
        "string",
        "null"
      ]
    },
    "cachePriority": {
      "type": [
        "integer",
        "null"
      ]
    },
    "debug": {
      "type": "boolean"
    },
    "extraArgs": {
      "type": "array"
    },
    "extraEnv": {
      "type": "array"
