            "enabled": {
              "type": "boolean"
            },
            "allowedServiceAccounts": {
              "type": "array"
            },
            "scopes": {
              "type": "array",
              "items": {
                "enum": [
                  "read",
                  "write",
                  "admin"
                ]
              }
            },
            "audience": {
              "type": "string"
            },
            "issuer": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "oidcProviders": {
          "type": "object"
        }
      },
      "additionalProperties": false
