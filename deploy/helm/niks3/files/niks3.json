          "expr": "histogram_quantile(0.9, sum by (le, route) (rate(niks3_http_request_duration_seconds_bucket{instance=~\"$instance\",route!~\"GET /health|GET /metrics\"}[$__rate_interval])))",
          "legendFormat": "{{route}}",
          "range": true
